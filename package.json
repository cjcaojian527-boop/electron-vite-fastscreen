{
  "name": "fastscreen-app",
  "version": "1.0.0",
  "description": "fastscreen",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "start": "chcp 65001 && electron-vite preview",
    "dev": "chcp 65001 && electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win -c electron-builder.config.js",
    "build:mac": "npm run build && electron-builder --mac -c electron-builder.config.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "antd": "^5.26.6",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "mime-types": "^3.0.1",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "open": "^10.2.0",
    "react-activation": "^0.13.4",
    "react-router-dom": "^7.7.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.89.2",
    "vite": "^6.2.6"
  }
}